# Application runtime environment: development, test, or production.
NODE_ENV=development
# Backend HTTP port.
PORT=3000
# NestJS log level: fatal, error, warn, log, debug, or verbose.
LOG_LEVEL=debug

# Docker Compose PostgreSQL database name.
POSTGRES_DB=wc_telegram
# Docker Compose PostgreSQL user.
POSTGRES_USER=wc_telegram
# Development-only PostgreSQL password; replace outside local development.
POSTGRES_PASSWORD=development-only-postgres-password
# PostgreSQL connection URL consumed by the backend.
DATABASE_URL=postgresql://wc_telegram:development-only-postgres-password@postgres:5432/wc_telegram

# Redis connection URL; URL form is the canonical convention.
REDIS_URL=redis://redis:6379

# Development-only Telegram token placeholder; replace with a real bot token.
TELEGRAM_BOT_TOKEN=0000000000:development-placeholder-token
# Shared service credential for authenticated backend↔bot internal requests.
BOT_INTERNAL_API_KEY=development-only-bot-internal-api-key
# Private backend-to-bot transport URL and bot listener port (not exposed by Caddy).
BOT_INTERNAL_URL=http://telegram-bot:3001
BOT_INTERNAL_PORT=3001
# Backend-to-bot prepared-message request deadline.
BOT_DELIVERY_TIMEOUT_MS=10000
# Backend API base URL used by the Telegram bot.
BACKEND_INTERNAL_URL=http://backend:3000/api
# Bot-to-backend request deadline.
BOT_BACKEND_TIMEOUT_MS=5000
# M12 order-status write deadline: three 15s WooCommerce caps plus 5s overhead.
BOT_STATUS_WRITE_TIMEOUT_MS=50000
# One-time Telegram account-link token lifetime in seconds.
TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
# Dedicated HMAC key for short-lived Telegram callback references.
TELEGRAM_CALLBACK_SIGNING_KEY=development-only-telegram-callback-signing-key
# Callback reference lifetime and projected-order delayed threshold in seconds.
TELEGRAM_CALLBACK_REF_TTL_SECONDS=900
TELEGRAM_ORDER_FRESHNESS_THRESHOLD_SECONDS=300
# Development-only JWT signing secret; minimum 32 characters.
JWT_SECRET=development-only-jwt-secret-change-me
# Access-token lifetime using a jsonwebtoken duration string.
JWT_ACCESS_TTL=15m
# Development-only base64 value encoding exactly 32 bytes.
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# WooCommerce REST validation resilience policy.
WOOCOMMERCE_REST_MAX_ATTEMPTS=3
WOOCOMMERCE_REST_ATTEMPT_TIMEOUT_MS=5000
WOOCOMMERCE_REST_TOTAL_TIMEOUT_MS=15000
WOOCOMMERCE_REST_BACKOFF_BASE_MS=300
WOOCOMMERCE_REST_BACKOFF_FACTOR=2
WOOCOMMERCE_REST_JITTER_RATIO=0.2

# One-time plugin registration handshake and endpoint-scoped rate limit.
PLUGIN_REGISTRATION_TOKEN_TTL_SECONDS=900
PLUGIN_REGISTRATION_RATE_LIMIT=10
PLUGIN_REGISTRATION_RATE_WINDOW_SECONDS=60

# Public account authentication uses independent endpoint-scoped Redis limits.
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60

# Private-pilot tooling is disabled unless explicitly enabled.
PILOT_MODE=false
# Approved public HTTPS Caddy origin used for WooCommerce webhook delivery.
PILOT_WEBHOOK_BASE_URL=https://pilot-api.example.com
# Bounded wait for the synthetic order projection during pilot readiness.
PILOT_READINESS_TIMEOUT_SECONDS=60

# Caddy development origin or production public HTTPS origin.
CADDY_DOMAIN=http://localhost

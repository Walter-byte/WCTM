# Application runtime environment: development, test, or production.
NODE_ENV=development
# Backend HTTP port.
PORT=3000
# NestJS log level: fatal, error, warn, log, debug, or verbose.
LOG_LEVEL=debug

# Docker Compose PostgreSQL database name.
POSTGRES_DB=wc_telegram
# Docker Compose PostgreSQL user.
POSTGRES_USER=wc_telegram
# Development-only PostgreSQL password; replace outside local development.
POSTGRES_PASSWORD=development-only-postgres-password
# PostgreSQL connection URL consumed by the backend.
DATABASE_URL=postgresql://wc_telegram:development-only-postgres-password@postgres:5432/wc_telegram

# Redis connection URL; URL form is the canonical convention.
REDIS_URL=redis://redis:6379

# Development-only Telegram token placeholder; replace with a real bot token.
TELEGRAM_BOT_TOKEN=0000000000:development-placeholder-token
# Development-only JWT signing secret; minimum 32 characters.
JWT_SECRET=development-only-jwt-secret-change-me
# Access-token lifetime using a jsonwebtoken duration string.
JWT_ACCESS_TTL=15m
# Development-only base64 value encoding exactly 32 bytes.
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Development-only WooCommerce webhook secret; minimum 32 characters.
WOOCOMMERCE_WEBHOOK_SECRET=development-only-webhook-secret-change-me
# WooCommerce REST validation resilience policy.
WOOCOMMERCE_REST_MAX_ATTEMPTS=3
WOOCOMMERCE_REST_ATTEMPT_TIMEOUT_MS=5000
WOOCOMMERCE_REST_TOTAL_TIMEOUT_MS=15000
WOOCOMMERCE_REST_BACKOFF_BASE_MS=300
WOOCOMMERCE_REST_BACKOFF_FACTOR=2
WOOCOMMERCE_REST_JITTER_RATIO=0.2

# Caddy development origin or production public HTTPS origin.
CADDY_DOMAIN=http://localhost

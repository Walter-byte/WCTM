NODE_ENV=development
PORT=3000

POSTGRES_DB=wc_telegram
POSTGRES_USER=wc_telegram
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://wc_telegram:replace-with-a-local-password@postgres:5432/wc_telegram

REDIS_URL=redis://redis:6379

TELEGRAM_BOT_TOKEN=0000000000:replace-with-a-real-telegram-token
JWT_SECRET=replace-with-a-long-random-jwt-secret
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
WOOCOMMERCE_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

CADDY_DOMAIN=http://localhost

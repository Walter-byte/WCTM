generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantPlan {
  FREE
  PRO
  AGENCY

  @@map("tenant_plan")
}

enum TenantEntitlementStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_entitlement_status")
}

enum StoreStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  DISABLED

  @@map("store_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum TenantLanguage {
  FA @map("fa")
  EN @map("en")

  @@map("tenant_language")
}

enum NotificationCategory {
  ORDER_CREATED
  LOW_STOCK

  @@map("notification_category")
}

enum NotificationRecipientMode {
  ALL_ELIGIBLE
  SELECTED

  @@map("notification_recipient_mode")
}

enum TelegramSettingsReferencePurpose {
  ACTION
  TIMEZONE_INPUT
  THRESHOLD_INPUT

  @@map("telegram_settings_reference_purpose")
}

enum TelegramSettingsAction {
  SET_LANGUAGE
  SET_CATEGORY
  SET_RECIPIENT_MODE
  SET_RECIPIENT_SELECTION
  CLEAR_THRESHOLD

  @@map("telegram_settings_action")
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("webhook_event_status")
}

enum TelegramChatType {
  PRIVATE

  @@map("telegram_chat_type")
}

enum TelegramCallbackPurpose {
  LIST_PAGE
  ORDER_DETAIL
  STATUS_WRITE
  NOTE_INPUT
  NOTE_CONFIRM

  @@map("telegram_callback_purpose")
}

enum TelegramOrderNoteVisibility {
  INTERNAL
  CUSTOMER

  @@map("telegram_order_note_visibility")
}

enum TelegramOrderNoteActionState {
  IN_FLIGHT
  SUCCEEDED
  FAILED
  AMBIGUOUS

  @@map("telegram_order_note_action_state")
}

enum TelegramCallbackDirection {
  CURRENT
  NEXT
  PREVIOUS

  @@map("telegram_callback_direction")
}

enum TelegramOrderNotificationState {
  PENDING
  IN_FLIGHT
  DELIVERED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  AMBIGUOUS

  @@map("telegram_order_notification_state")
}

enum InventorySyncState {
  UNINITIALIZED
  SYNCING
  READY
  FAILED

  @@map("inventory_sync_state")
}

enum InventoryItemKind {
  PRODUCT
  VARIATION

  @@map("inventory_item_kind")
}

enum InventoryAlertClassification {
  OUT_OF_STOCK
  LOW_STOCK
  HEALTHY

  @@map("inventory_alert_classification")
}

enum InventoryAlertLevel {
  LOW_STOCK
  OUT_OF_STOCK

  @@map("inventory_alert_level")
}

enum TelegramInventoryReferencePurpose {
  LIST_PAGE
  ITEM_DETAIL

  @@map("telegram_inventory_reference_purpose")
}

enum TelegramInventoryNotificationState {
  PENDING
  IN_FLIGHT
  DELIVERED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  AMBIGUOUS

  @@map("telegram_inventory_notification_state")
}

enum TelegramSearchReferencePurpose {
  PAGE
  RESULT

  @@map("telegram_search_reference_purpose")
}

enum TelegramSearchResultKind {
  ORDER
  INVENTORY

  @@map("telegram_search_result_kind")
}

model Tenant {
  id                          String                                  @id @map("id") @db.VarChar(64)
  name                        String                                  @map("name") @db.VarChar(255)
  plan                        TenantPlan                              @default(FREE) @map("plan")
  entitlementStatus           TenantEntitlementStatus                 @default(ACTIVE) @map("entitlement_status")
  entitlementExpiresAt        DateTime?                               @map("entitlement_expires_at") @db.Timestamptz(3)
  timezone                    String                                  @default("UTC") @map("timezone") @db.VarChar(64)
  language                    TenantLanguage                          @default(FA) @map("language")
  createdAt                   DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                   DateTime?                               @map("deleted_at") @db.Timestamptz(3)
  memberships                 Membership[]
  stores                      Store[]
  orders                      Order[]
  webhookEvents               WebhookEvent[]
  auditLogs                   AuditLog[]
  telegramChatAuthorizations  TelegramChatAuthorization[]             @relation("TelegramActiveTenant")
  telegramCallbackReferences  TelegramCallbackReference[]
  telegramOrderStatusWrites   TelegramOrderStatusWrite[]
  telegramOrderNoteActions    TelegramOrderNoteAction[]
  telegramOrderNotifications  TelegramOrderNotificationDelivery[]
  telegramSettingsReferences  TelegramSettingsReference[]
  inventoryItems              InventoryItem[]
  inventoryNotifications      TelegramInventoryNotificationDelivery[]
  telegramInventoryReferences TelegramInventoryReference[]
  telegramSearchReferences    TelegramSearchReference[]

  @@map("tenants")
}

model User {
  id                 String              @id @map("id") @db.VarChar(64)
  email              String              @unique @map("email") @db.VarChar(320)
  passwordHash       String?             @map("password_hash") @db.Text
  displayName        String?             @map("display_name") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  auditLogs          AuditLog[]
  telegramAccount    TelegramAccount?
  telegramLinkTokens TelegramLinkToken[]

  @@map("users")
}

model Membership {
  id                             String                       @id @map("id") @db.VarChar(64)
  tenantId                       String                       @map("tenant_id") @db.VarChar(64)
  userId                         String                       @map("user_id") @db.VarChar(64)
  role                           MembershipRole               @default(MEMBER) @map("role")
  createdAt                      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                      DateTime?                    @map("deleted_at") @db.Timestamptz(3)
  tenant                         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                           User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedNotificationRecipients StoreNotificationRecipient[]
  telegramSettingsReferences     TelegramSettingsReference[]
  telegramSearchReferences       TelegramSearchReference[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Store {
  id                                      String                                  @id @map("id") @db.VarChar(64)
  tenantId                                String                                  @map("tenant_id") @db.VarChar(64)
  name                                    String                                  @map("name") @db.VarChar(255)
  baseUrl                                 String                                  @map("base_url") @db.Text
  status                                  StoreStatus                             @default(PENDING) @map("status")
  consumerKeyEncrypted                    String                                  @map("consumer_key_encrypted") @db.Text
  consumerSecretEncrypted                 String                                  @map("consumer_secret_encrypted") @db.Text
  webhookSecretEncrypted                  String?                                 @map("webhook_secret_encrypted") @db.Text
  webhookEndpointKey                      String?                                 @unique @map("webhook_endpoint_key") @db.VarChar(64)
  registrationTokenHash                   String?                                 @unique @map("registration_token_hash") @db.VarChar(64)
  registrationTokenExpiresAt              DateTime?                               @map("registration_token_expires_at") @db.Timestamptz(3)
  registrationTokenConsumedAt             DateTime?                               @map("registration_token_consumed_at") @db.Timestamptz(3)
  pluginSecretHash                        String?                                 @map("plugin_secret_hash") @db.VarChar(64)
  pluginRegisteredAt                      DateTime?                               @map("plugin_registered_at") @db.Timestamptz(3)
  lastSeenAt                              DateTime?                               @map("last_seen_at") @db.Timestamptz(3)
  lastHealthyAt                           DateTime?                               @map("last_healthy_at") @db.Timestamptz(3)
  lowStockThreshold                       Int?                                    @map("low_stock_threshold")
  enabledNotificationCategories           NotificationCategory[]                  @default([ORDER_CREATED]) @map("enabled_notification_categories")
  notificationRecipientMode               NotificationRecipientMode               @default(ALL_ELIGIBLE) @map("notification_recipient_mode")
  inventoryNotificationPolicyVersion      Int                                     @default(0) @map("inventory_notification_policy_version")
  inventorySyncState                      InventorySyncState                      @default(UNINITIALIZED) @map("inventory_sync_state")
  inventoryBootstrapStartedAt             DateTime?                               @map("inventory_bootstrap_started_at") @db.Timestamptz(3)
  inventoryBootstrapCompletedAt           DateTime?                               @map("inventory_bootstrap_completed_at") @db.Timestamptz(3)
  inventoryBootstrapFailedAt              DateTime?                               @map("inventory_bootstrap_failed_at") @db.Timestamptz(3)
  inventoryBootstrapFailureCode           String?                                 @map("inventory_bootstrap_failure_code") @db.VarChar(191)
  inventoryBootstrapProductPage           Int                                     @default(1) @map("inventory_bootstrap_product_page")
  inventoryBootstrapVariationPage         Int                                     @default(1) @map("inventory_bootstrap_variation_page")
  inventoryBootstrapParentIds             String[]                                @default([]) @map("inventory_bootstrap_parent_ids")
  inventoryBootstrapProductsDone          Boolean                                 @default(false) @map("inventory_bootstrap_products_done")
  inventoryBootstrapRevision              Int                                     @default(0) @map("inventory_bootstrap_revision")
  inventoryBootstrapLeaseAt               DateTime?                               @map("inventory_bootstrap_lease_at") @db.Timestamptz(3)
  createdAt                               DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                               DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                               DateTime?                               @map("deleted_at") @db.Timestamptz(3)
  tenant                                  Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders                                  Order[]
  webhookEvents                           WebhookEvent[]
  telegramChatAuthorizations              TelegramChatAuthorization[]             @relation("TelegramActiveStore")
  telegramCallbackReferences              TelegramCallbackReference[]
  telegramOrderStatusWrites               TelegramOrderStatusWrite[]
  telegramOrderNoteActions                TelegramOrderNoteAction[]
  telegramOrderNotifications              TelegramOrderNotificationDelivery[]
  selectedNotificationRecipients          StoreNotificationRecipient[]
  telegramSettingsReferences              TelegramSettingsReference[]
  inventoryItems                          InventoryItem[]
  telegramInventoryReferences             TelegramInventoryReference[]
  telegramInventoryNotificationDeliveries TelegramInventoryNotificationDelivery[]
  telegramSearchReferences                TelegramSearchReference[]

  @@unique([tenantId, baseUrl])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("stores")
}

model WebhookEvent {
  id                     String                                  @id @map("id") @db.VarChar(64)
  tenantId               String                                  @map("tenant_id") @db.VarChar(64)
  storeId                String                                  @map("store_id") @db.VarChar(64)
  webhookId              String                                  @map("webhook_id") @db.VarChar(191)
  deliveryId             String                                  @map("delivery_id") @db.VarChar(191)
  dedupeKey              String                                  @map("dedupe_key") @db.VarChar(255)
  topic                  String                                  @map("topic") @db.VarChar(191)
  payload                Json                                    @map("payload") @db.JsonB
  status                 WebhookEventStatus                      @default(RECEIVED) @map("status")
  receivedAt             DateTime                                @default(now()) @map("received_at") @db.Timestamptz(3)
  queuedAt               DateTime?                               @map("queued_at") @db.Timestamptz(3)
  processingStartedAt    DateTime?                               @map("processing_started_at") @db.Timestamptz(3)
  processingAttemptCount Int                                     @default(0) @map("processing_attempt_count")
  failureCategory        String?                                 @map("failure_category") @db.VarChar(32)
  failureMessage         String?                                 @map("failure_message") @db.VarChar(191)
  lastFailureAt          DateTime?                               @map("last_failure_at") @db.Timestamptz(3)
  completedAt            DateTime?                               @map("completed_at") @db.Timestamptz(3)
  failedAt               DateTime?                               @map("failed_at") @db.Timestamptz(3)
  createdAt              DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                  Store                                   @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  telegramNotifications  TelegramOrderNotificationDelivery[]
  inventoryNotifications TelegramInventoryNotificationDelivery[]

  @@unique([storeId, dedupeKey])
  @@unique([id, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@map("webhook_events")
}

model Order {
  id                    String                              @id @map("id") @db.VarChar(64)
  tenantId              String                              @map("tenant_id") @db.VarChar(64)
  storeId               String                              @map("store_id") @db.VarChar(64)
  wcOrderId             String                              @map("wc_order_id") @db.VarChar(32)
  orderNumber           String                              @map("order_number") @db.VarChar(191)
  status                String                              @map("status") @db.VarChar(64)
  currency              String                              @map("currency") @db.VarChar(16)
  totals                Json                                @map("totals") @db.JsonB
  customerSnapshot      Json                                @map("customer_snapshot") @db.JsonB
  lineItemsSnapshot     Json                                @map("line_items_snapshot") @db.JsonB
  paymentSnapshot       Json                                @map("payment_snapshot") @db.JsonB
  shippingLinesSnapshot Json                                @map("shipping_lines_snapshot") @db.JsonB
  wcCreatedAt           DateTime                            @map("wc_created_at") @db.Timestamptz(3)
  wcModifiedAt          DateTime                            @map("wc_modified_at") @db.Timestamptz(3)
  projectionFingerprint String                              @map("projection_fingerprint") @db.VarChar(64)
  remoteDeletedAt       DateTime?                           @map("remote_deleted_at") @db.Timestamptz(3)
  lastSyncedAt          DateTime                            @map("last_synced_at") @db.Timestamptz(3)
  createdAt             DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                 Store                               @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  telegramNotifications TelegramOrderNotificationDelivery[]

  @@unique([storeId, wcOrderId])
  @@index([tenantId])
  @@index([storeId])
  @@map("orders")
}

model AuditLog {
  id         String   @id @map("id") @db.VarChar(64)
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     String?  @map("user_id") @db.VarChar(64)
  action     String   @map("action") @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?    @map("metadata") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

model TelegramAccount {
  id                     String                                  @id @map("id") @db.VarChar(64)
  telegramUserId         BigInt                                  @unique @map("telegram_user_id")
  userId                 String                                  @unique @map("user_id") @db.VarChar(64)
  lastRedeemUpdateId     BigInt?                                 @map("last_redeem_update_id")
  lastUnlinkUpdateId     BigInt?                                 @map("last_unlink_update_id")
  createdAt              DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?                               @map("deleted_at") @db.Timestamptz(3)
  user                   User                                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chatAuthorizations     TelegramChatAuthorization[]
  callbackReferences     TelegramCallbackReference[]
  orderStatusWrites      TelegramOrderStatusWrite[]
  orderNoteActions       TelegramOrderNoteAction[]
  orderNotifications     TelegramOrderNotificationDelivery[]
  inventoryNotifications TelegramInventoryNotificationDelivery[]
  inventoryReferences    TelegramInventoryReference[]
  settingsReferences     TelegramSettingsReference[]
  searchReferences       TelegramSearchReference[]

  @@index([userId])
  @@map("telegram_accounts")
}

model StoreNotificationRecipient {
  id           String     @id @map("id") @db.VarChar(64)
  tenantId     String     @map("tenant_id") @db.VarChar(64)
  storeId      String     @map("store_id") @db.VarChar(64)
  membershipId String     @map("membership_id") @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  store        Store      @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, membershipId])
  @@index([tenantId, storeId])
  @@index([tenantId, membershipId])
  @@map("store_notification_recipients")
}

model TelegramSettingsReference {
  id                   String                           @id @map("id") @db.VarChar(64)
  telegramAccountId    String                           @map("telegram_account_id") @db.VarChar(64)
  telegramChatId       BigInt                           @map("telegram_chat_id")
  tenantId             String                           @map("tenant_id") @db.VarChar(64)
  storeId              String                           @map("store_id") @db.VarChar(64)
  purpose              TelegramSettingsReferencePurpose @map("purpose")
  action               TelegramSettingsAction?          @map("action")
  language             TenantLanguage?                  @map("language")
  notificationCategory NotificationCategory?            @map("notification_category")
  desiredEnabled       Boolean?                         @map("desired_enabled")
  recipientMode        NotificationRecipientMode?       @map("recipient_mode")
  targetMembershipId   String?                          @map("target_membership_id") @db.VarChar(64)
  expiresAt            DateTime                         @map("expires_at") @db.Timestamptz(3)
  consumedAt           DateTime?                        @map("consumed_at") @db.Timestamptz(3)
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramAccount      TelegramAccount                  @relation(fields: [telegramAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant               Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                Store                            @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  targetMembership     Membership?                      @relation(fields: [targetMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([telegramAccountId])
  @@index([telegramChatId])
  @@index([tenantId, storeId])
  @@index([expiresAt])
  @@map("telegram_settings_references")
}

model TelegramChatAuthorization {
  id                     String                                  @id @map("id") @db.VarChar(64)
  telegramAccountId      String                                  @map("telegram_account_id") @db.VarChar(64)
  telegramChatId         BigInt                                  @unique @map("telegram_chat_id")
  chatType               TelegramChatType                        @map("chat_type")
  activeTenantId         String?                                 @map("active_tenant_id") @db.VarChar(64)
  activeStoreId          String?                                 @map("active_store_id") @db.VarChar(64)
  revokedAt              DateTime?                               @map("revoked_at") @db.Timestamptz(3)
  createdAt              DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramAccount        TelegramAccount                         @relation(fields: [telegramAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeTenant           Tenant?                                 @relation("TelegramActiveTenant", fields: [activeTenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activeStore            Store?                                  @relation("TelegramActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orderNotifications     TelegramOrderNotificationDelivery[]
  inventoryNotifications TelegramInventoryNotificationDelivery[]

  @@unique([id, telegramAccountId])
  @@index([telegramAccountId])
  @@index([activeTenantId])
  @@index([activeStoreId])
  @@map("telegram_chat_authorizations")
}

model TelegramLinkToken {
  id         String    @id @map("id") @db.VarChar(64)
  userId     String    @map("user_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("telegram_link_tokens")
}

model TelegramCallbackReference {
  id                     String                       @id @map("id") @db.VarChar(64)
  telegramAccountId      String                       @map("telegram_account_id") @db.VarChar(64)
  telegramChatId         BigInt                       @map("telegram_chat_id")
  tenantId               String                       @map("tenant_id") @db.VarChar(64)
  storeId                String                       @map("store_id") @db.VarChar(64)
  purpose                TelegramCallbackPurpose      @map("purpose")
  direction              TelegramCallbackDirection?   @map("direction")
  boundaryWcCreatedAt    DateTime?                    @map("boundary_wc_created_at") @db.Timestamptz(3)
  boundaryWcOrderId      String?                      @map("boundary_wc_order_id") @db.VarChar(32)
  targetWcOrderId        String?                      @map("target_wc_order_id") @db.VarChar(32)
  reachableOffset        Int?                         @map("reachable_offset")
  backReferenceId        String?                      @map("back_reference_id") @db.VarChar(64)
  allowedTargetStatuses  String[]                     @default([]) @map("allowed_target_statuses")
  claimedTargetStatus    String?                      @map("claimed_target_status") @db.VarChar(64)
  noteVisibility         TelegramOrderNoteVisibility? @map("note_visibility")
  noteBodyEncrypted      String?                      @map("note_body_encrypted") @db.Text
  noteContentFingerprint String?                      @map("note_content_fingerprint") @db.VarChar(64)
  noteClaimedAt          DateTime?                    @map("note_claimed_at") @db.Timestamptz(3)
  expiresAt              DateTime                     @map("expires_at") @db.Timestamptz(3)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramAccount        TelegramAccount              @relation(fields: [telegramAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant                 Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                  Store                        @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusWrites           TelegramOrderStatusWrite[]
  noteActions            TelegramOrderNoteAction[]

  @@index([telegramAccountId])
  @@index([telegramChatId])
  @@index([tenantId, storeId])
  @@index([expiresAt])
  @@map("telegram_callback_references")
}

model TelegramOrderNoteAction {
  id                  String                       @id @map("id") @db.VarChar(64)
  callbackReferenceId String                       @unique @map("callback_reference_id") @db.VarChar(64)
  telegramAccountId   String                       @map("telegram_account_id") @db.VarChar(64)
  tenantId            String                       @map("tenant_id") @db.VarChar(64)
  storeId             String                       @map("store_id") @db.VarChar(64)
  wcOrderId           String                       @map("wc_order_id") @db.VarChar(32)
  visibility          TelegramOrderNoteVisibility  @map("visibility")
  contentFingerprint  String                       @map("content_fingerprint") @db.VarChar(64)
  state               TelegramOrderNoteActionState @default(IN_FLIGHT) @map("state")
  result              Json?                        @map("result") @db.JsonB
  startedAt           DateTime                     @default(now()) @map("started_at") @db.Timestamptz(3)

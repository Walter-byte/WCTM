generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantPlan {
  FREE
  PRO
  AGENCY

  @@map("tenant_plan")
}

enum StoreStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  DISABLED

  @@map("store_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("webhook_event_status")
}

enum TelegramChatType {
  PRIVATE

  @@map("telegram_chat_type")
}

enum TelegramCallbackPurpose {
  LIST_PAGE
  ORDER_DETAIL

  @@map("telegram_callback_purpose")
}

enum TelegramCallbackDirection {
  CURRENT
  NEXT
  PREVIOUS

  @@map("telegram_callback_direction")
}

model Tenant {
  id                         String                      @id @map("id") @db.VarChar(64)
  name                       String                      @map("name") @db.VarChar(255)
  plan                       TenantPlan                  @default(FREE) @map("plan")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  memberships                Membership[]
  stores                     Store[]
  orders                     Order[]
  webhookEvents              WebhookEvent[]
  auditLogs                  AuditLog[]
  telegramChatAuthorizations TelegramChatAuthorization[] @relation("TelegramActiveTenant")
  telegramCallbackReferences TelegramCallbackReference[]

  @@map("tenants")
}

model User {
  id                 String              @id @map("id") @db.VarChar(64)
  email              String              @unique @map("email") @db.VarChar(320)
  displayName        String?             @map("display_name") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  auditLogs          AuditLog[]
  telegramAccount    TelegramAccount?
  telegramLinkTokens TelegramLinkToken[]

  @@map("users")
}

model Membership {
  id        String         @id @map("id") @db.VarChar(64)
  tenantId  String         @map("tenant_id") @db.VarChar(64)
  userId    String         @map("user_id") @db.VarChar(64)
  role      MembershipRole @default(MEMBER) @map("role")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(3)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Store {
  id                          String                      @id @map("id") @db.VarChar(64)
  tenantId                    String                      @map("tenant_id") @db.VarChar(64)
  name                        String                      @map("name") @db.VarChar(255)
  baseUrl                     String                      @map("base_url") @db.Text
  status                      StoreStatus                 @default(PENDING) @map("status")
  consumerKeyEncrypted        String                      @map("consumer_key_encrypted") @db.Text
  consumerSecretEncrypted     String                      @map("consumer_secret_encrypted") @db.Text
  webhookSecretEncrypted      String?                     @map("webhook_secret_encrypted") @db.Text
  webhookEndpointKey          String?                     @unique @map("webhook_endpoint_key") @db.VarChar(64)
  registrationTokenHash       String?                     @unique @map("registration_token_hash") @db.VarChar(64)
  registrationTokenExpiresAt  DateTime?                   @map("registration_token_expires_at") @db.Timestamptz(3)
  registrationTokenConsumedAt DateTime?                   @map("registration_token_consumed_at") @db.Timestamptz(3)
  pluginSecretHash            String?                     @map("plugin_secret_hash") @db.VarChar(64)
  pluginRegisteredAt          DateTime?                   @map("plugin_registered_at") @db.Timestamptz(3)
  lastSeenAt                  DateTime?                   @map("last_seen_at") @db.Timestamptz(3)
  lastHealthyAt               DateTime?                   @map("last_healthy_at") @db.Timestamptz(3)
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                   DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  tenant                      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders                      Order[]
  webhookEvents               WebhookEvent[]
  telegramChatAuthorizations  TelegramChatAuthorization[] @relation("TelegramActiveStore")
  telegramCallbackReferences  TelegramCallbackReference[]

  @@unique([tenantId, baseUrl])
  @@index([tenantId])
  @@map("stores")
}

model WebhookEvent {
  id                     String             @id @map("id") @db.VarChar(64)
  tenantId               String             @map("tenant_id") @db.VarChar(64)
  storeId                String             @map("store_id") @db.VarChar(64)
  webhookId              String             @map("webhook_id") @db.VarChar(191)
  deliveryId             String             @map("delivery_id") @db.VarChar(191)
  dedupeKey              String             @map("dedupe_key") @db.VarChar(255)
  topic                  String             @map("topic") @db.VarChar(191)
  payload                Json               @map("payload") @db.JsonB
  status                 WebhookEventStatus @default(RECEIVED) @map("status")
  receivedAt             DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  queuedAt               DateTime?          @map("queued_at") @db.Timestamptz(3)
  processingStartedAt    DateTime?          @map("processing_started_at") @db.Timestamptz(3)
  processingAttemptCount Int                @default(0) @map("processing_attempt_count")
  failureCategory        String?            @map("failure_category") @db.VarChar(32)
  failureMessage         String?            @map("failure_message") @db.VarChar(191)
  lastFailureAt          DateTime?          @map("last_failure_at") @db.Timestamptz(3)
  completedAt            DateTime?          @map("completed_at") @db.Timestamptz(3)
  failedAt               DateTime?          @map("failed_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                  Store              @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, dedupeKey])
  @@index([tenantId])
  @@index([storeId])
  @@map("webhook_events")
}

model Order {
  id                    String    @id @map("id") @db.VarChar(64)
  tenantId              String    @map("tenant_id") @db.VarChar(64)
  storeId               String    @map("store_id") @db.VarChar(64)
  wcOrderId             String    @map("wc_order_id") @db.VarChar(32)
  orderNumber           String    @map("order_number") @db.VarChar(191)
  status                String    @map("status") @db.VarChar(64)
  currency              String    @map("currency") @db.VarChar(16)
  totals                Json      @map("totals") @db.JsonB
  customerSnapshot      Json      @map("customer_snapshot") @db.JsonB
  lineItemsSnapshot     Json      @map("line_items_snapshot") @db.JsonB
  wcCreatedAt           DateTime  @map("wc_created_at") @db.Timestamptz(3)
  wcModifiedAt          DateTime  @map("wc_modified_at") @db.Timestamptz(3)
  projectionFingerprint String    @map("projection_fingerprint") @db.VarChar(64)
  remoteDeletedAt       DateTime? @map("remote_deleted_at") @db.Timestamptz(3)
  lastSyncedAt          DateTime  @map("last_synced_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([storeId, wcOrderId])
  @@index([tenantId])
  @@index([storeId])
  @@map("orders")
}

model AuditLog {
  id         String   @id @map("id") @db.VarChar(64)
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     String?  @map("user_id") @db.VarChar(64)
  action     String   @map("action") @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?    @map("metadata") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

model TelegramAccount {
  id                 String                      @id @map("id") @db.VarChar(64)
  telegramUserId     BigInt                      @unique @map("telegram_user_id")
  userId             String                      @unique @map("user_id") @db.VarChar(64)
  lastRedeemUpdateId BigInt?                     @map("last_redeem_update_id")
  lastUnlinkUpdateId BigInt?                     @map("last_unlink_update_id")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chatAuthorizations TelegramChatAuthorization[]
  callbackReferences TelegramCallbackReference[]

  @@index([userId])
  @@map("telegram_accounts")
}

model TelegramChatAuthorization {
  id                String           @id @map("id") @db.VarChar(64)
  telegramAccountId String           @map("telegram_account_id") @db.VarChar(64)
  telegramChatId    BigInt           @unique @map("telegram_chat_id")
  chatType          TelegramChatType @map("chat_type")
  activeTenantId    String?          @map("active_tenant_id") @db.VarChar(64)
  activeStoreId     String?          @map("active_store_id") @db.VarChar(64)
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramAccount   TelegramAccount  @relation(fields: [telegramAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeTenant      Tenant?          @relation("TelegramActiveTenant", fields: [activeTenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activeStore       Store?           @relation("TelegramActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([telegramAccountId])
  @@index([activeTenantId])
  @@index([activeStoreId])
  @@map("telegram_chat_authorizations")
}

model TelegramLinkToken {
  id         String    @id @map("id") @db.VarChar(64)
  userId     String    @map("user_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("telegram_link_tokens")
}

model TelegramCallbackReference {
  id                  String                     @id @map("id") @db.VarChar(64)
  telegramAccountId   String                     @map("telegram_account_id") @db.VarChar(64)
  telegramChatId      BigInt                     @map("telegram_chat_id")
  tenantId            String                     @map("tenant_id") @db.VarChar(64)
  storeId             String                     @map("store_id") @db.VarChar(64)
  purpose             TelegramCallbackPurpose    @map("purpose")
  direction           TelegramCallbackDirection? @map("direction")
  boundaryWcCreatedAt DateTime?                  @map("boundary_wc_created_at") @db.Timestamptz(3)
  boundaryWcOrderId   String?                    @map("boundary_wc_order_id") @db.VarChar(32)
  targetWcOrderId     String?                    @map("target_wc_order_id") @db.VarChar(32)
  reachableOffset     Int?                       @map("reachable_offset")
  backReferenceId     String?                    @map("back_reference_id") @db.VarChar(64)
  expiresAt           DateTime                   @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramAccount     TelegramAccount            @relation(fields: [telegramAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store               Store                      @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([telegramAccountId])
  @@index([telegramChatId])
  @@index([tenantId, storeId])
  @@index([expiresAt])
  @@map("telegram_callback_references")
}

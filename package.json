{
  "name": "wc-telegram-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for managing WooCommerce stores through Telegram.",
  "workspaces": [
    "backend",
    "telegram-bot"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"{backend,telegram-bot}/src/**/*.ts\"",
    "format": "prettier --write \".eslintrc.js\" \"*.json\" \"*.md\" \"*.yml\" \".github/workflows/*.yml\" \"backend/**/*.{json,ts}\" \"backend/test/**/*.cjs\" \"telegram-bot/**/*.{json,ts}\" \"docs/SETUP.md\"",
    "format:check": "prettier --check \".eslintrc.js\" \"*.json\" \"*.md\" \"*.yml\" \".github/workflows/*.yml\" \"backend/**/*.{json,ts}\" \"backend/test/**/*.cjs\" \"telegram-bot/**/*.{json,ts}\" \"docs/SETUP.md\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}

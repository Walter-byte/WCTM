{
	# Caddy automatically provisions TLS for public domains.
	# For localhost development, Caddy uses its local certificate authority.
}

{$CADDY_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"

	handle /api/* {
		reverse_proxy backend:{$BACKEND_PORT:3000}
	}

	handle /onboarding* {
		rewrite * /api{uri}
		reverse_proxy backend:{$BACKEND_PORT:3000}
	}

	handle {
		respond "WC-Telegram-SaaS is running" 200
	}
}
